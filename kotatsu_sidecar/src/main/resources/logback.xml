<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
  <!-- request logging (source, endpoint, duration, status) comes from
       Ktor's CallLogging on this logger -->
  <logger name="ktor.application" level="INFO"/>
</configuration>
