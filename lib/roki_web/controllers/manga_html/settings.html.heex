<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center justify-end mb-6">
    <div class="flex items-center gap-2">
      <%= if @resume_manga do %>
        <a
          href={
            ~p"/manga/#{@resume_manga.source}/#{@resume_manga.slug}/#{@resume_manga.last_chapter}"
          }
          class="btn btn-sm sm:btn-md sm:px-8 btn-primary"
        >
          ▶ Resume
        </a>
      <% end %>
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </div>
        <ul
          tabindex="0"
          class="dropdown-content menu bg-base-200 rounded-box z-30 w-40 p-2 shadow-lg"
        >
          <li><a href="/manga">Home</a></li>
          <li><a href="/manga/history">History</a></li>
          <li><a href="/manga/stats">Stats</a></li>
          <li><a href="/manga/comments">Comments</a></li>
          <li><a href="/manga/tierlist">Tierlist</a></li>
          <li><a href="/manga/grid">Grid</a></li>
          <li><a href="/manga/settings" class="font-semibold">Settings</a></li>
        </ul>
      </div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-4">Settings</h2>

  <div class="space-y-4">
    <div class="bg-base-200 rounded-xl p-4">
      <div class="flex items-center justify-between">
        <div>
          <p class="font-medium">Timezone</p>
          <p class="text-sm text-base-content/60">Used for reading history hour tracking.</p>
        </div>
      </div>
      <% tz_val = @user.user_timezone || "0" %>
      <% tz_options = [
        {"UTC-12 (Baker Island)", "-12"},
        {"UTC-11 (Pago Pago, Niue)", "-11"},
        {"UTC-10 (Honolulu, Tahiti)", "-10"},
        {"UTC-9 (Anchorage, Juneau)", "-9"},
        {"UTC-8 (Los Angeles, Vancouver)", "-8"},
        {"UTC-7 (Denver, Phoenix, Calgary)", "-7"},
        {"UTC-6 (Chicago, Mexico City)", "-6"},
        {"UTC-5 (New York, Toronto, Bogotá)", "-5"},
        {"UTC-4 (Halifax, Caracas, Santiago)", "-4"},
        {"UTC-3 (Buenos Aires, São Paulo)", "-3"},
        {"UTC-2 (South Georgia)", "-2"},
        {"UTC-1 (Azores, Cape Verde)", "-1"},
        {"UTC+0 (London, Dublin, Lisbon)", "0"},
        {"UTC+1 (Paris, Berlin, Rome, Madrid)", "1"},
        {"UTC+2 (Kyiv, Athens, Helsinki, Cairo)", "2"},
        {"UTC+3 (Istanbul, Riyadh, Moscow)", "3"},
        {"UTC+4 (Dubai, Baku, Tbilisi)", "4"},
        {"UTC+5 (Karachi, Tashkent)", "5"},
        {"UTC+5:30 (Mumbai, Delhi, Kolkata)", "5.5"},
        {"UTC+6 (Dhaka, Almaty)", "6"},
        {"UTC+7 (Bangkok, Jakarta)", "7"},
        {"UTC+8 (Beijing, Singapore, Hong Kong)", "8"},
        {"UTC+9 (Tokyo, Seoul)", "9"},
        {"UTC+9:30 (Adelaide, Darwin)", "9.5"},
        {"UTC+10 (Sydney, Melbourne, Brisbane)", "10"},
        {"UTC+11 (Honiara, Noumea)", "11"},
        {"UTC+12 (Auckland, Fiji, Wellington)", "12"},
        {"UTC+13 (Nuku'alofa, Apia)", "13"},
        {"UTC+14 (Kiritimati)", "14"}
      ] %>
      <select id="timezone-select" class="select select-bordered select-sm w-full mt-3">
        <%= for {label, value} <- tz_options do %>
          <option value={value} selected={tz_val == value}>{label}</option>
        <% end %>
      </select>
    </div>
    <div class="flex items-center justify-between bg-base-200 rounded-xl p-4">
      <div>
        <p class="font-medium">Auto-resume</p>
        <p class="text-sm text-base-content/60">
          When you open the Reader home page, automatically redirect to your last-read manga after a countdown.
        </p>
      </div>
      <input
        type="checkbox"
        class="toggle toggle-primary"
        id="auto-resume-toggle"
        checked={(@user.custom_fields || %{})["auto_resume"] == true}
      />
    </div>
    <div class="flex items-center justify-between bg-base-200 rounded-xl p-4">
      <div>
        <p class="font-medium">Auto-resume timer</p>
        <p class="text-sm text-base-content/60">
          How long to wait before auto-resuming your last read.
        </p>
      </div>
      <select id="auto-resume-timer-select" class="select select-bordered select-sm w-24">
        <% timer_val = (@user.custom_fields || %{})["auto_resume_timer"] || 5 %>
        <%= for s <- 2..10 do %>
          <option value={s} selected={timer_val == s}>{s}s</option>
        <% end %>
      </select>
    </div>
    <div class="bg-base-200 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <div>
          <p class="font-medium">Auto-resume backdrop</p>
          <p class="text-sm text-base-content/60">
            Custom image shown behind the auto-resume popup.
          </p>
        </div>
      </div>
      <% art_uuid = (@user.custom_fields || %{})["auto_resume_art"] %>
      <div id="auto-resume-art-section">
        <%= if art_uuid do %>
          <div class="flex items-center gap-3 mb-2">
            <img
              id="auto-resume-art-preview"
              src={PhoenixKit.Modules.Storage.URLSigner.signed_url(art_uuid, "original")}
              class="w-24 h-16 object-cover rounded-lg border border-base-content/10"
            />
            <button
              type="button"
              id="auto-resume-art-remove"
              class="btn btn-sm btn-error btn-outline"
            >Remove</button>
          </div>
        <% else %>
          <div id="auto-resume-art-preview-wrap" class="hidden flex items-center gap-3 mb-2">
            <img
              id="auto-resume-art-preview"
              src=""
              class="w-24 h-16 object-cover rounded-lg border border-base-content/10"
            />
            <button
              type="button"
              id="auto-resume-art-remove"
              class="btn btn-sm btn-error btn-outline"
            >Remove</button>
          </div>
        <% end %>
        <input type="file" id="auto-resume-art-input" accept="image/*" class="hidden" />
        <button type="button" id="auto-resume-art-upload" class="btn btn-sm btn-outline">
          {if art_uuid, do: "Change Image", else: "Upload Image"}
        </button>
      </div>
    </div>
    <div class="bg-base-200 rounded-xl p-4">
      <p class="font-medium mb-1">Default tap zone layout</p>
      <p class="text-sm text-base-content/60 mb-3">Global default for all manga.</p>
      <% default_tap = (@user.custom_fields || %{})["default_tap_zone"] || "default" %>
      <div class="flex flex-row gap-3" id="default-tap-zone-presets">
        <label
          class={"cursor-pointer flex flex-col items-center gap-1.5 p-2 rounded-lg border-2 flex-1 #{if default_tap == "default", do: "border-primary bg-primary/5", else: "border-base-content/20 bg-transparent"} default-tap-zone-card"}
          data-preset="default"
        >
          <input
            type="radio"
            name="default_tap_zone"
            value="default"
            class="hidden"
            checked={default_tap == "default"}
          />
          <div class="relative w-20 aspect-[3/4] rounded border border-base-content/20 overflow-hidden bg-base-300">
            <div class="absolute top-0 left-0 bottom-0 w-1/3 bg-green-500/30 flex items-center justify-center text-green-900 font-bold text-[7px] border-r border-green-500/40">
              N
            </div>
            <div class="absolute top-0 right-0 bottom-0 w-1/3 bg-green-500/30 flex items-center justify-center text-green-900 font-bold text-[7px] border-l border-green-500/40">
              N
            </div>
            <div class="absolute top-0 left-1/3 right-1/3 h-1/2 bg-blue-500/30 flex items-center justify-center text-blue-900 font-bold text-[7px] border-b border-blue-500/40">
              M
            </div>
            <div class="absolute bottom-0 left-1/3 right-1/3 h-1/2 bg-red-500/30 flex items-center justify-center text-red-900 font-bold text-[7px] border-t border-red-500/40">
              P
            </div>
          </div>
          <span class="text-xs font-medium">Default</span>
        </label>
        <label
          class={"cursor-pointer flex flex-col items-center gap-1.5 p-2 rounded-lg border-2 flex-1 #{if default_tap == "left_right", do: "border-primary bg-primary/5", else: "border-base-content/20 bg-transparent"} default-tap-zone-card"}
          data-preset="left_right"
        >
          <input
            type="radio"
            name="default_tap_zone"
            value="left_right"
            class="hidden"
            checked={default_tap == "left_right"}
          />
          <div class="relative w-20 aspect-[3/4] rounded border border-base-content/20 overflow-hidden bg-base-300">
            <div class="absolute top-0 left-0 bottom-0 w-1/3 bg-red-500/30 flex items-center justify-center text-red-900 font-bold text-[7px] border-r border-red-500/40">
              P
            </div>
            <div class="absolute top-0 right-0 bottom-0 w-1/3 bg-green-500/30 flex items-center justify-center text-green-900 font-bold text-[7px] border-l border-green-500/40">
              N
            </div>
            <div class="absolute inset-0 left-1/3 right-1/3 bg-blue-500/30 flex items-center justify-center text-blue-900 font-bold text-[7px]">
              M
            </div>
          </div>
          <span class="text-xs font-medium">Left / Right</span>
        </label>
        <label
          class={"cursor-pointer flex flex-col items-center gap-1.5 p-2 rounded-lg border-2 flex-1 #{if default_tap == "right_left", do: "border-primary bg-primary/5", else: "border-base-content/20 bg-transparent"} default-tap-zone-card"}
          data-preset="right_left"
        >
          <input
            type="radio"
            name="default_tap_zone"
            value="right_left"
            class="hidden"
            checked={default_tap == "right_left"}
          />
          <div class="relative w-20 aspect-[3/4] rounded border border-base-content/20 overflow-hidden bg-base-300">
            <div class="absolute top-0 left-0 bottom-0 w-1/3 bg-green-500/30 flex items-center justify-center text-green-900 font-bold text-[7px] border-r border-green-500/40">
              N
            </div>
            <div class="absolute top-0 right-0 bottom-0 w-1/3 bg-red-500/30 flex items-center justify-center text-red-900 font-bold text-[7px] border-l border-red-500/40">
              P
            </div>
            <div class="absolute inset-0 left-1/3 right-1/3 bg-blue-500/30 flex items-center justify-center text-blue-900 font-bold text-[7px]">
              M
            </div>
          </div>
          <span class="text-xs font-medium">Right / Left</span>
        </label>
      </div>
    </div>
    <div class="bg-base-200 rounded-xl p-4">
      <p class="font-medium mb-1">Default reading direction</p>
      <p class="text-sm text-base-content/60 mb-3">
        Global default for new manga without a saved direction.
      </p>
      <% default_dir = (@user.custom_fields || %{})["default_reading_direction"] || "rtl" %>
      <div class="flex flex-row gap-3" id="default-reading-direction-buttons">
        <button
          type="button"
          data-direction="rtl"
          class={"btn btn-sm flex-1 #{if default_dir == "rtl", do: "btn-primary", else: "btn-ghost border-base-content/20"} default-dir-btn"}
        >RTL ←</button>
        <button
          type="button"
          data-direction="ltr"
          class={"btn btn-sm flex-1 #{if default_dir == "ltr", do: "btn-primary", else: "btn-ghost border-base-content/20"} default-dir-btn"}
        >LTR →</button>
      </div>
    </div>
    <div class="flex items-center justify-between bg-base-200 rounded-xl p-4">
      <div>
        <p class="font-medium">Default panel snap</p>
        <p class="text-sm text-base-content/60">
          Enable panel snap (smart scroll) by default for new manga. Can be toggled per-manga in the reader.
        </p>
      </div>
      <input
        type="checkbox"
        class="toggle toggle-primary"
        id="default-smart-scroll-toggle"
        checked={(@user.custom_fields || %{})["default_smart_scroll"] == true}
      />
    </div>
    <% ssc = (@user.custom_fields || %{})["smart_scroll_config"] || %{} %>
    <div class="bg-base-200 rounded-xl p-4 space-y-4" id="smart-scroll-config-section">
      <div>
        <p class="font-medium">Panel snap settings</p>
        <p class="text-sm text-base-content/60">
          Global defaults for panel snap behavior. Can be overridden per-manga in the reader settings.
        </p>
      </div>
      <div class="flex items-center justify-between">
        <p class="text-sm">Jump style</p>
        <% jump_val = ssc["jump_style"] || "smooth" %>
        <div class="flex flex-row gap-3" id="ssc-jump-style-buttons">
          <button
            type="button"
            data-value="smooth"
            class={"btn btn-sm flex-1 #{if jump_val == "smooth", do: "btn-primary", else: "btn-ghost border-base-content/20"} ssc-jump-btn"}
          >Smooth</button>
          <button
            type="button"
            data-value="instant"
            class={"btn btn-sm flex-1 #{if jump_val == "instant", do: "btn-primary", else: "btn-ghost border-base-content/20"} ssc-jump-btn"}
          >Instant</button>
        </div>
      </div>
      <div class="flex items-center justify-between">
        <p class="text-sm">Scan distance</p>
        <% scan_val = ssc["scan_distance"] || 3 %>
        <select id="ssc-scan-distance" class="select select-bordered select-sm w-24">
          <%= for n <- 1..5 do %>
            <option value={n} selected={scan_val == n}>{n}x</option>
          <% end %>
        </select>
      </div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm">Long panel steps</p>
          <p class="text-xs text-base-content/50">Break tall panels into half-viewport jumps</p>
        </div>
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="ssc-long-panel-steps"
          checked={Map.get(ssc, "long_panel_steps", true) == true}
        />
      </div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm">Gutter tolerance</p>
          <p id="ssc-gutter-hint" class="text-xs text-base-content/50">Solid + light texture</p>
        </div>
        <% tolerance_val = ssc["gutter_tolerance"] || 300 %>
        <select id="ssc-gutter-tolerance" class="select select-bordered select-sm w-32">
          <option value="50" selected={tolerance_val == 50}>Strict</option>
          <option value="300" selected={tolerance_val == 300}>Normal</option>
          <option value="800" selected={tolerance_val == 800}>Relaxed</option>
          <option value="1500" selected={tolerance_val == 1500}>Aggressive</option>
        </select>
      </div>
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm">Min gutter width</p>
          <p id="ssc-gutter-width-hint" class="text-xs text-base-content/50">
            Standard gutter width
          </p>
        </div>
        <% gutter_width_val = ssc["min_gutter_width"] || 50 %>
        <select id="ssc-min-gutter-width" class="select select-bordered select-sm w-32">
          <option value="20" selected={gutter_width_val == 20}>Narrow</option>
          <option value="50" selected={gutter_width_val == 50}>Normal</option>
          <option value="100" selected={gutter_width_val == 100}>Wide</option>
        </select>
      </div>
      <button type="button" id="ssc-reset" class="btn btn-sm btn-ghost text-error w-full">Reset to defaults</button>
    </div>
  </div>
</div>

<script>
  document.getElementById('auto-resume-toggle').addEventListener('change', function() {
    const enabled = this.checked;
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    fetch('/manga/settings/auto_resume', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ enabled: enabled })
    });
  });
  document.getElementById('auto-resume-timer-select').addEventListener('change', function() {
    const seconds = parseInt(this.value, 10);
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    fetch('/manga/settings/auto_resume_timer', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ seconds: seconds })
    });
  });
  document.getElementById('timezone-select').addEventListener('change', function() {
    const offset = this.value;
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    fetch('/manga/settings/timezone', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ offset: offset })
    });
  });
  document.querySelectorAll('#default-tap-zone-presets input[name="default_tap_zone"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      const preset = this.value;
      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      fetch('/manga/settings/default_tap_zone', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ preset: preset })
      });
      document.querySelectorAll('.default-tap-zone-card').forEach(function(card) {
        if (card.dataset.preset === preset) {
          card.classList.remove('border-base-content/20', 'bg-transparent');
          card.classList.add('border-primary', 'bg-primary/5');
        } else {
          card.classList.remove('border-primary', 'bg-primary/5');
          card.classList.add('border-base-content/20', 'bg-transparent');
        }
      });
    });
  });
  document.getElementById('default-smart-scroll-toggle').addEventListener('change', function() {
    const enabled = this.checked;
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    fetch('/manga/settings/default_smart_scroll', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ enabled: enabled })
    });
  });

  // Smart scroll config (global defaults)
  function saveScrollConfig(patch) {
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    // Build full config from current UI state
    const jumpBtn = document.querySelector('.ssc-jump-btn.btn-primary');
    const config = {
      jump_style: patch.jump_style || (jumpBtn ? jumpBtn.dataset.value : 'smooth'),
      scan_distance: patch.scan_distance || parseInt(document.getElementById('ssc-scan-distance').value),
      long_panel_steps: patch.long_panel_steps !== undefined ? patch.long_panel_steps : document.getElementById('ssc-long-panel-steps').checked,
      gutter_tolerance: patch.gutter_tolerance || parseInt(document.getElementById('ssc-gutter-tolerance').value),
      min_gutter_width: patch.min_gutter_width || parseInt(document.getElementById('ssc-min-gutter-width').value)
    };
    Object.assign(config, patch);
    fetch('/manga/settings/smart_scroll_config', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
      body: JSON.stringify({ config: config })
    });
  }

  document.querySelectorAll('.ssc-jump-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const value = this.dataset.value;
      document.querySelectorAll('.ssc-jump-btn').forEach(function(b) {
        if (b.dataset.value === value) {
          b.classList.remove('btn-ghost', 'border-base-content/20');
          b.classList.add('btn-primary');
        } else {
          b.classList.remove('btn-primary');
          b.classList.add('btn-ghost', 'border-base-content/20');
        }
      });
      saveScrollConfig({ jump_style: value });
    });
  });

  document.getElementById('ssc-scan-distance').addEventListener('change', function() {
    saveScrollConfig({ scan_distance: parseInt(this.value) });
  });

  document.getElementById('ssc-long-panel-steps').addEventListener('change', function() {
    saveScrollConfig({ long_panel_steps: this.checked });
  });

  var sscToleranceHints = { '50': 'Solid color only', '300': 'Solid + light texture', '800': 'Heavy texture / dark noise', '1500': 'Nearly anything non-artwork' };
  var sscGutterHint = document.getElementById('ssc-gutter-hint');
  function updateSscGutterHint(val) { if (sscGutterHint) sscGutterHint.textContent = sscToleranceHints[val] || ''; }
  updateSscGutterHint(document.getElementById('ssc-gutter-tolerance').value);
  document.getElementById('ssc-gutter-tolerance').addEventListener('change', function() {
    saveScrollConfig({ gutter_tolerance: parseInt(this.value) });
    updateSscGutterHint(this.value);
  });

  var sscGutterWidthHints = { '20': 'Thin gutters / tightly packed', '50': 'Standard gutter width', '100': 'Only snap on wide gaps' };
  var sscGutterWidthHint = document.getElementById('ssc-gutter-width-hint');
  function updateSscGutterWidthHint(val) { if (sscGutterWidthHint) sscGutterWidthHint.textContent = sscGutterWidthHints[val] || ''; }
  updateSscGutterWidthHint(document.getElementById('ssc-min-gutter-width').value);
  document.getElementById('ssc-min-gutter-width').addEventListener('change', function() {
    saveScrollConfig({ min_gutter_width: parseInt(this.value) });
    updateSscGutterWidthHint(this.value);
  });

  document.getElementById('ssc-reset').addEventListener('click', function() {
    var defaults = { jump_style: 'smooth', scan_distance: 3, long_panel_steps: true, gutter_tolerance: 300, min_gutter_width: 50 };
    // Update UI
    document.querySelectorAll('.ssc-jump-btn').forEach(function(b) {
      if (b.dataset.value === defaults.jump_style) {
        b.classList.remove('btn-ghost', 'border-base-content/20');
        b.classList.add('btn-primary');
      } else {
        b.classList.remove('btn-primary');
        b.classList.add('btn-ghost', 'border-base-content/20');
      }
    });
    document.getElementById('ssc-scan-distance').value = defaults.scan_distance;
    document.getElementById('ssc-long-panel-steps').checked = defaults.long_panel_steps;
    document.getElementById('ssc-gutter-tolerance').value = defaults.gutter_tolerance;
    updateSscGutterHint(String(defaults.gutter_tolerance));
    document.getElementById('ssc-min-gutter-width').value = defaults.min_gutter_width;
    updateSscGutterWidthHint(String(defaults.min_gutter_width));
    // Save
    saveScrollConfig(defaults);
  });

  document.querySelectorAll('.default-dir-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const direction = this.dataset.direction;
      const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      fetch('/manga/settings/default_reading_direction', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
        body: JSON.stringify({ direction: direction })
      });
      document.querySelectorAll('.default-dir-btn').forEach(function(b) {
        if (b.dataset.direction === direction) {
          b.classList.remove('btn-ghost', 'border-base-content/20');
          b.classList.add('btn-primary');
        } else {
          b.classList.remove('btn-primary');
          b.classList.add('btn-ghost', 'border-base-content/20');
        }
      });
    });
  });

  // Auto-resume backdrop art upload
  (function() {
    var uploadBtn = document.getElementById('auto-resume-art-upload');
    var fileInput = document.getElementById('auto-resume-art-input');
    var removeBtn = document.getElementById('auto-resume-art-remove');
    var preview = document.getElementById('auto-resume-art-preview');
    var previewWrap = document.getElementById('auto-resume-art-preview-wrap');

    uploadBtn.addEventListener('click', function() { fileInput.click(); });

    fileInput.addEventListener('change', async function() {
      var file = this.files[0];
      if (!file) return;
      var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
      try {
        var form = new FormData();
        form.append('file', file);
        var uploadRes = await fetch('/phoenix_kit/api/upload', {
          method: 'POST',
          headers: { 'x-csrf-token': csrfToken },
          body: form
        });
        if (!uploadRes.ok) throw new Error('Upload failed');
        var uploadData = await uploadRes.json();

        var saveRes = await fetch('/manga/settings/auto_resume_art', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ file_uuid: uploadData.file_uuid })
        });
        if (!saveRes.ok) throw new Error('Save failed');
        var saveData = await saveRes.json();

        preview.src = saveData.art_url;
        if (previewWrap) previewWrap.classList.remove('hidden');
        uploadBtn.textContent = 'Change Image';
      } catch (e) {
        alert('Failed to upload: ' + e.message);
      }
      fileInput.value = '';
    });

    if (removeBtn) {
      removeBtn.addEventListener('click', async function() {
        var csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
        await fetch('/manga/settings/auto_resume_art', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrfToken },
          body: JSON.stringify({ clear: true })
        });
        preview.src = '';
        if (previewWrap) previewWrap.classList.add('hidden');
        var parentDiv = preview.closest('.flex');
        if (parentDiv && !previewWrap) parentDiv.classList.add('hidden');
        uploadBtn.textContent = 'Upload Image';
      });
    }
  })();
</script>
