<%!-- Rows-only fragment for infinite scroll. The first matching node
     in the response is appended into `#ann-list`; the `#ann-loader`
     div (if present) replaces the old sentinel so the IntersectionObserver
     keeps firing. No outer chrome — the page already has the layout. --%>
<.comment_entry :for={a <- @annotations} a={a} />
<div
  :if={@next_cursor}
  id="ann-loader"
  data-next={@next_cursor}
  class="text-center py-6 text-sm text-base-content/40"
>
  Loading more…
</div>
