<%!-- The site's listing look: a coloured hero under the floating header, the search in it. --%>
<RokiWeb.PageHero.page_hero eyebrow="Manga" title="Explore" hue={300}>
  <a
    href="/manga"
    class="absolute right-4 top-16 z-20 inline-flex h-11 items-center gap-1.5 rounded-full border border-white/25 bg-black/35 px-4 text-sm font-medium backdrop-blur-md transition hover:border-white/60 hover:bg-black/55 sm:right-6 lg:right-12 lg:top-20 xl:right-16"
  >
    <RokiWeb.CoreComponents.icon name="hero-arrow-left-micro" class="h-4 w-4" /> Your manga
  </a>
  <form
    method="get"
    action="/manga/search"
    role="search"
    class="flex max-w-3xl items-center gap-2"
  >
    <input
      type="search"
      name="q"
      placeholder="Search manga across every source"
      autocomplete="off"
      maxlength="120"
      style="background-color: rgb(0 0 0 / 0.3)"
      class="input h-12 min-w-0 flex-1 rounded-full border border-white/25 px-5 text-white backdrop-blur-md placeholder:text-white/60 focus:border-white/60 focus:outline-none"
    />
    <button
      type="submit"
      aria-label="Search"
      class="btn btn-primary h-12 min-h-0 shrink-0 rounded-full max-sm:w-12 max-sm:px-0 sm:px-6"
    >
      <RokiWeb.CoreComponents.icon name="hero-magnifying-glass" class="h-5 w-5 sm:hidden" />
      <span class="max-sm:hidden">Search</span>
    </button>
  </form>
</RokiWeb.PageHero.page_hero>

<div class={RokiWeb.PageHero.content_class()}>
  <%= if @manga != [] do %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <div
        :for={manga <- @manga}
        class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow"
      >
        <a href={~p"/manga/#{manga.source}/#{manga.slug}"} class="relative">
          <figure class="px-2 pt-2">
            <img
              src={cover_image_src(manga, @cover_paths, "medium")}
              alt={manga.title}
              class="rounded-lg w-full aspect-[3/4] object-cover"
            />
          </figure>
          <% count = Map.get(@comment_counts, {manga.source, manga.slug}, 0) %>
          <span :if={count > 0} class="absolute top-3 right-3 badge badge-sm badge-primary gap-1">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
            /></svg>
            {count}
          </span>
        </a>
        <div class="card-body p-3">
          <a href={~p"/manga/#{manga.source}/#{manga.slug}"}>
            <h2 class="card-title text-sm line-clamp-2">{manga.title}</h2>
          </a>
          <div class="flex items-center gap-2 text-xs text-base-content/60 flex-wrap">
            <span>{manga.reader_count} {if manga.reader_count == 1, do: "reader", else: "readers"}</span>
            <%= if (rt = format_reading_time(manga.total_seconds)) do %>
              <span>&middot; {rt}</span>
            <% end %>
            <span>&middot; {Roki.Manga.Sources.label(manga.source)}</span>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-16">
      <p class="text-base-content/70">
        No manga discovered yet. Titles saved by other readers will appear here.
      </p>
    </div>
  <% end %>

  <%!-- Catalog rows from enabled kotatsu extensions (Settings →
       Source extensions). Each row loads ASYNC after the page
       renders — one fragment request per source, filled in as they
       answer, so the slowest site never blocks the page. --%>
  <%= if @kotatsu_pending != [] do %>
    <div class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold">Extensions</h2>
        <a href={~p"/manga/extensions"} class="text-sm text-primary hover:underline">Manage</a>
      </div>
      <%= for {ext_name, ext_label, _searchable} <- @kotatsu_pending do %>
        <div class="mb-6">
          <h3 class="text-base font-semibold mb-3">{ext_label}</h3>
          <div class="ext-async" data-url={~p"/manga/explore/extension?#{%{source: ext_name}}"}>
            <div class="flex items-center gap-2 text-sm text-base-content/40 py-4">
              <span class="loading loading-spinner loading-xs"></span> Loading…
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <script>
      document.querySelectorAll(".ext-async").forEach((el) => {
        fetch(el.dataset.url, { credentials: "same-origin" })
          .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
          .then((html) => { el.innerHTML = html; })
          .catch(() => {
            el.innerHTML = '<p class="text-sm text-base-content/50">Unavailable (failed to load)</p>';
          });
      });
    </script>
  <% end %>
</div>
