<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <a href={~p"/manga"} class="text-2xl font-bold hover:opacity-80">📖 Reader</a>
    <div class="flex items-center gap-2">
      <%= if @resume_manga do %>
        <a
          href={~p"/manga/#{@resume_manga.source}/#{@resume_manga.slug}/#{@resume_manga.last_chapter}"}
          class="btn btn-sm sm:btn-md sm:px-8 btn-primary"
        >
          ▶ Resume
        </a>
      <% end %>
      <Layouts.theme_toggle />
      <Layouts.notifications_bell parent={@conn} scope={@phoenix_kit_current_scope} />
      <Layouts.user_menu scope={@phoenix_kit_current_scope} current_path={@conn.request_path} />
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-30 w-40 p-2 shadow-lg">
          <li><a href="/manga">Home</a></li>
          <li><a href="/manga/explore" class="font-semibold">Explore</a></li>
          <li><a href="/manga/history">History</a></li>
          <li><a href="/manga/stats">Stats</a></li>
          <li><a href="/manga/comments">Comments</a></li>
          <li><a href="/manga/categories">Categories</a></li>
          <li><a href="/manga/tierlist">Tierlist</a></li>
          <li><a href="/manga/grid">Grid</a></li>
          <li><a href="/manga/settings">Settings</a></li>
        </ul>
      </div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-4">Explore</h2>

  <form method="get" action="/manga/search" class="flex gap-2 mb-6">
    <input
      type="text"
      name="q"
      placeholder="Search manga..."
      class="input input-bordered flex-1"
    />
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <%= if @manga != [] do %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
      <div :for={manga <- @manga} class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <a href={~p"/manga/#{manga.source}/#{manga.slug}"} class="relative">
          <figure class="px-2 pt-2">
            <img
              src={cover_image_src(manga, @cover_paths, "medium")}
              alt={manga.title}
              class="rounded-lg w-full aspect-[3/4] object-cover"
            />
          </figure>
          <% count = Map.get(@comment_counts, {manga.source, manga.slug}, 0) %>
          <span :if={count > 0} class="absolute top-3 right-3 badge badge-sm badge-primary gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
            {count}
          </span>
        </a>
        <div class="card-body p-3">
          <a href={~p"/manga/#{manga.source}/#{manga.slug}"}>
            <h2 class="card-title text-sm line-clamp-2">{manga.title}</h2>
          </a>
          <div class="flex items-center gap-2 text-xs text-base-content/60 flex-wrap">
            <span>{manga.reader_count} <%= if manga.reader_count == 1, do: "reader", else: "readers" %></span>
            <%= if (rt = format_reading_time(manga.total_seconds)) do %>
              <span>&middot; {rt}</span>
            <% end %>
            <span>&middot; {Roki.Manga.Sources.label(manga.source)}</span>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-center py-16">
      <p class="text-base-content/70">
        No manga discovered yet. Titles saved by other readers will appear here.
      </p>
    </div>
  <% end %>

  <%!-- Catalog rows from enabled kotatsu extensions (Settings →
       Source extensions). Each row loads ASYNC after the page
       renders — one fragment request per source, filled in as they
       answer, so the slowest site never blocks the page. --%>
  <%= if @kotatsu_pending != [] do %>
    <div class="mt-10">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold">Extensions</h2>
        <a href={~p"/manga/extensions"} class="text-sm text-primary hover:underline">Manage</a>
      </div>
      <%= for {ext_name, ext_label, _searchable} <- @kotatsu_pending do %>
        <div class="mb-6">
          <h3 class="text-base font-semibold mb-3">{ext_label}</h3>
          <div class="ext-async" data-url={~p"/manga/explore/extension?#{%{source: ext_name}}"}>
            <div class="flex items-center gap-2 text-sm text-base-content/40 py-4">
              <span class="loading loading-spinner loading-xs"></span> Loading…
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <script>
      document.querySelectorAll(".ext-async").forEach((el) => {
        fetch(el.dataset.url, { credentials: "same-origin" })
          .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
          .then((html) => { el.innerHTML = html; })
          .catch(() => {
            el.innerHTML = '<p class="text-sm text-base-content/50">Unavailable (failed to load)</p>';
          });
      });
    </script>
  <% end %>
</div>
