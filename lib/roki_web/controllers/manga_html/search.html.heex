<div class="max-w-6xl mx-auto px-4 py-8">
  <RokiWeb.Layouts.manga_title back="/manga/explore" back_label="Explore">
    Search
  </RokiWeb.Layouts.manga_title>

  <form method="get" action="/manga/search" class="flex gap-2 mb-6">
    <%= if @mode == :single do %>
      <input type="hidden" name="source" value={@source} />
    <% end %>
    <input
      type="text"
      name="q"
      value={@query}
      placeholder="Search manga..."
      class="input input-bordered flex-1"
      autofocus
    />
    <button type="submit" class="btn btn-primary">Search</button>
  </form>

  <%= if @others_saved != [] do %>
    <div class="border border-base-300 rounded-xl p-4 mb-6">
      <h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 mb-4">
        Already saved
      </h3>
      <div class="flex overflow-x-auto gap-3 pb-2">
        <a
          :for={m <- @others_saved}
          href={~p"/manga/#{m.source}/#{m.slug}?#{%{sq: @query}}"}
          class="flex-shrink-0 w-32"
          title={m.title}
        >
          <figure class="relative">
            <img
              src={m.cover_src}
              alt={m.title}
              class="rounded-lg w-full aspect-[3/4] object-cover"
            />
            <span class="absolute top-1 right-1 badge badge-sm bg-black/70 text-white border-0">{Roki.Manga.Sources.label(
              m.source
            )}</span>
            <span
              :if={m.users > 1}
              class="absolute bottom-1 left-1 badge badge-sm bg-black/70 text-white border-0"
            >{m.users}×</span>
          </figure>
          <p class="text-sm mt-1 line-clamp-2">{m.title}</p>
        </a>
      </div>
    </div>
  <% end %>

  <%= if @mode == :kotatsu_single do %>
    <%!-- Single kotatsu-extension view --%>
    <a
      href={~p"/manga/search?#{%{q: @query}}"}
      class="inline-flex items-center gap-1 text-sm text-primary mb-4"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All sources
    </a>

    <h3 class="text-base font-semibold mb-4">
      {@kotatsu_source} <span class="badge badge-outline badge-sm ml-1">extension</span>
    </h3>

    <%= cond do %>
      <% @kotatsu_error != nil -> %>
        <div class="alert alert-warning">Search failed: {inspect(@kotatsu_error)}</div>
      <% @results == [] -> %>
        <div class="text-center py-16">
          <p class="text-base-content/70">No results found for "{@query}".</p>
        </div>
      <% true -> %>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
          <a
            :for={result <- @results}
            href={
              ~p"/manga/kotatsu/#{Roki.Manga.KotatsuSource.build_slug(@kotatsu_source, result.ref.url)}?#{%{st: result.title}}"
            }
            class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow"
          >
            <figure class="px-2 pt-2">
              <%= if result.cover_url do %>
                <img
                  src={
                    ~p"/manga/kotatsu/image?#{%{source: @kotatsu_source, url: result.cover_url}}"
                  }
                  alt={result.title}
                  loading="lazy"
                  class="rounded-lg w-full aspect-[3/4] object-cover"
                />
              <% else %>
                <div class="rounded-lg w-full aspect-[3/4] bg-base-300"></div>
              <% end %>
            </figure>
            <div class="card-body p-3">
              <h2 class="card-title text-sm line-clamp-2">{result.title}</h2>
            </div>
          </a>
        </div>
    <% end %>
  <% end %>

  <%= if @mode == :single do %>
    <%!-- Single-source view --%>
    <a
      href={~p"/manga/search?#{%{q: @query}}"}
      class="inline-flex items-center gap-1 text-sm text-primary mb-4"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      All sources
    </a>

    <h3 class="text-base font-semibold mb-4">{@source_label}</h3>

    <%= if @results != [] do %>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <div
          :for={result <- @results}
          class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow"
        >
          <a href={~p"/manga/#{@source}/#{result.slug}?#{%{sq: @query, ss: @source}}"}>
            <figure class="px-2 pt-2">
              <%= if result.cover_url do %>
                <img
                  src={~p"/manga/proxy/image?#{%{url: result.cover_url}}"}
                  alt={result.title}
                  class="rounded-lg w-full aspect-[3/4] object-cover"
                />
              <% else %>
                <div class="rounded-lg w-full aspect-[3/4] bg-base-300 flex items-center justify-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-10 w-10 text-base-content/30"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                    />
                  </svg>
                </div>
              <% end %>
            </figure>
          </a>
          <div class="card-body p-3">
            <a href={~p"/manga/#{@source}/#{result.slug}?#{%{sq: @query, ss: @source}}"}>
              <h2 class="card-title text-sm line-clamp-2">{result.title}</h2>
            </a>
          </div>
        </div>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-base-content/70">No results found for "{@query}".</p>
      </div>
    <% end %>
  <% else %>
    <%!-- All-sources view --%>
    <%= if @query != "" do %>
      <%= for {lang_label, sources} <- @results_grouped do %>
        <div class="border border-base-300 rounded-xl p-4 mb-6">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 mb-4">
            {lang_label}
          </h3>
          <%= for {source_key, label, results} <- sources do %>
            <div class="mb-5 last:mb-0">
              <a
                href={~p"/manga/search?#{%{q: @query, source: source_key}}"}
                class="inline-flex items-center gap-1 text-base font-semibold hover:text-primary mb-3"
              >
                {label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>

              <%= if results == [] do %>
                <p class="text-sm text-base-content/50">No results</p>
              <% else %>
                <div class="flex overflow-x-auto gap-3 pb-2">
                  <%= for result <- Enum.take(results, 10) do %>
                    <a
                      href={~p"/manga/#{source_key}/#{result.slug}?#{%{sq: @query}}"}
                      class="flex-shrink-0 w-32"
                    >
                      <figure>
                        <%= if result.cover_url do %>
                          <img
                            src={~p"/manga/proxy/image?#{%{url: result.cover_url}}"}
                            alt={result.title}
                            class="rounded-lg w-full aspect-[3/4] object-cover"
                          />
                        <% else %>
                          <div class="rounded-lg w-full aspect-[3/4] bg-base-300 flex items-center justify-center">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              class="h-10 w-10 text-base-content/30"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                              />
                            </svg>
                          </div>
                        <% end %>
                      </figure>
                      <p class="text-sm mt-1 line-clamp-2">{result.title}</p>
                    </a>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%!-- Enabled kotatsu extensions (Settings → Source extensions).
           Each row loads ASYNC after the page renders — one fragment
           request per source, filled in as they answer, so the
           slowest site never blocks the page. --%>
      <%= if @kotatsu_pending != [] do %>
        <div class="border border-base-300 rounded-xl p-4 mb-6">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 mb-4">
            Extensions
          </h3>
          <%= for {ext_name, ext_label, searchable} <- @kotatsu_pending do %>
            <div class="mb-5 last:mb-0">
              <a
                href={~p"/manga/search?#{%{q: @query, source: "kotatsu:" <> ext_name}}"}
                class="inline-flex items-center gap-1 text-base font-semibold hover:text-primary mb-3"
              >
                {ext_label}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"
                  />
                </svg>
              </a>

              <%= if searchable do %>
                <div
                  class="ext-async"
                  data-url={~p"/manga/search/extension?#{%{source: ext_name, q: @query}}"}
                >
                  <div class="flex items-center gap-2 text-sm text-base-content/40 py-4">
                    <span class="loading loading-spinner loading-xs"></span> Searching…
                  </div>
                </div>
              <% else %>
                <p class="text-sm text-base-content/50">No text search — Explore only</p>
              <% end %>
            </div>
          <% end %>
        </div>
        <script>
          document.querySelectorAll(".ext-async").forEach((el) => {
            fetch(el.dataset.url, { credentials: "same-origin" })
              .then((r) => (r.ok ? r.text() : Promise.reject(r.status)))
              .then((html) => { el.innerHTML = html; })
              .catch(() => {
                el.innerHTML = '<p class="text-sm text-base-content/50">Unavailable (failed to load)</p>';
              });
          });
        </script>
      <% end %>
    <% else %>
      <div class="text-center py-16">
        <p class="text-base-content/70">Enter a search term to find manga across sources.</p>
      </div>
    <% end %>
  <% end %>
</div>
