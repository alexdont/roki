<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <a href={~p"/manga"} class="text-2xl font-bold hover:opacity-80">📖 Reader</a>
    <div class="flex items-center gap-2">
      <%= if @resume_manga do %>
        <a
          href={~p"/manga/#{@resume_manga.source}/#{@resume_manga.slug}/#{@resume_manga.last_chapter}"}
          class="btn btn-sm sm:btn-md sm:px-8 btn-primary"
        >
          ▶ Resume
        </a>
      <% end %>
      <Layouts.theme_toggle />
      <Layouts.notifications_bell parent={@conn} scope={@phoenix_kit_current_scope} />
      <Layouts.user_menu scope={@phoenix_kit_current_scope} current_path={@conn.request_path} />
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" class="btn btn-ghost btn-sm btn-square">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </div>
        <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-30 w-40 p-2 shadow-lg">
          <li><a href="/manga">Home</a></li>
          <li><a href="/manga/explore">Explore</a></li>
          <li><a href="/manga/history">History</a></li>
          <li><a href="/manga/stats">Stats</a></li>
          <li><a href="/manga/comments" class="font-semibold">Comments</a></li>
          <li><a href="/manga/categories">Categories</a></li>
          <li><a href="/manga/tierlist">Tierlist</a></li>
          <li><a href="/manga/grid">Grid</a></li>
          <li><a href="/manga/settings">Settings</a></li>
        </ul>
      </div>
    </div>
  </div>

  <h2 class="text-lg font-semibold mb-4">Recent Comments</h2>

  <%= if @annotations != [] do %>
    <input id="ann-search" type="text" placeholder="Search comments..." class="input input-bordered input-lg w-full mb-3" autocomplete="off" />
    <div class="flex items-center justify-between mb-3">
      <div id="ann-colors" class="flex gap-2">
        <button :for={color <- @colors_used} data-color={color} class="w-7 h-7 rounded-full cursor-pointer ring-2 ring-offset-2 ring-transparent transition-all hover:scale-110" style={"background-color: #{annotation_color(color)}"} title={color}></button>
      </div>
      <div class="flex gap-2">
        <select :if={length(@filter_usernames) > 1} id="ann-user-filter" class="select select-bordered select-sm max-w-[120px] sm:max-w-none">
          <option value="">All users</option>
          <option :for={user <- @filter_usernames} value={user}>{user}</option>
        </select>
        <select :if={length(@filter_titles) > 1} id="ann-title-filter" class="select select-bordered select-sm max-w-[120px] sm:max-w-none">
          <option value="">All manga</option>
          <option :for={{title, source} <- @filter_titles} value={title}>{title} ({Roki.Manga.Sources.label(source)})</option>
        </select>
      </div>
    </div>
    <div id="ann-list" class="flex flex-col gap-2">
      <.annotation_row :for={a <- @annotations} a={a} />
    </div>
    <div :if={@next_cursor} id="ann-loader" data-next={@next_cursor} class="text-center py-6 text-sm text-base-content/40">
      Loading more…
    </div>
  <% else %>
    <div class="text-center py-16">
      <p class="text-base-content/70">
        No comments yet. Open a chapter and use the comment tool to add comments to pages.
      </p>
    </div>
  <% end %>
</div>
<script>
  {
    let t, activeColor = null, activeUser = null, activeTitle = null;
    // Resolve a button's effective swatch color from its own style so
    // both legacy named colors and etcher hex values render correctly.
    const swatchColor = (btn) => btn.style.backgroundColor || getComputedStyle(btn).backgroundColor;

    function filterAnnotations() {
      const q = (document.getElementById("ann-search")?.value || "").toLowerCase();
      document.querySelectorAll("#ann-list > a").forEach(el => {
        const matchText = !q || el.textContent.toLowerCase().includes(q);
        const matchColor = !activeColor || el.dataset.color === activeColor;
        const matchUser = !activeUser || el.dataset.user === activeUser;
        const matchTitle = !activeTitle || el.dataset.title === activeTitle;
        el.style.display = matchText && matchColor && matchUser && matchTitle ? "" : "none";
      });
    }

    document.getElementById("ann-search")?.addEventListener("input", () => {
      clearTimeout(t);
      t = setTimeout(filterAnnotations, 250);
    });

    // Delegated click handler — new buttons added as later pages load
    // pick up the same behavior without re-binding.
    document.getElementById("ann-colors")?.addEventListener("click", (e) => {
      const btn = e.target.closest("button[data-color]");
      if (!btn) return;
      const color = btn.dataset.color;
      if (activeColor === color) {
        activeColor = null;
        document.querySelectorAll("#ann-colors button").forEach(b => b.style.outline = "");
      } else {
        activeColor = color;
        document.querySelectorAll("#ann-colors button").forEach(b => b.style.outline = "");
        btn.style.outline = `2px solid ${swatchColor(btn)}`;
      }
      filterAnnotations();
    });

    // Grow the color row when a later page introduces a color (named or
    // raw hex) that wasn't in the pre-fetched palette. New buttons are
    // appended at the end — the pre-fetched palette already covers the
    // common case, so this is just an escape hatch for stragglers.
    function syncColorButtons(rows) {
      const row = document.getElementById("ann-colors");
      if (!row) return;
      const existing = new Set(Array.from(row.querySelectorAll("button")).map(b => b.dataset.color));
      rows.forEach(r => {
        const c = r.dataset.color;
        if (!c || existing.has(c)) return;
        const btn = document.createElement("button");
        btn.dataset.color = c;
        btn.className = "w-7 h-7 rounded-full cursor-pointer ring-2 ring-offset-2 ring-transparent transition-all hover:scale-110";
        btn.style.backgroundColor = c;
        btn.title = c;
        row.appendChild(btn);
        existing.add(c);
      });
    }

    document.getElementById("ann-user-filter")?.addEventListener("change", (e) => {
      activeUser = e.target.value || null;
      filterAnnotations();
    });

    document.getElementById("ann-title-filter")?.addEventListener("change", (e) => {
      activeTitle = e.target.value || null;
      filterAnnotations();
    });

    // Localize <time> elements; safe to re-run on appended subtrees —
    // already-localized nodes carry a dataset flag so they're skipped.
    function localizeTimes(root) {
      root.querySelectorAll(".local-time").forEach(el => {
        if (el.dataset.localized) return;
        const d = new Date(el.getAttribute("datetime"));
        el.textContent = d.toLocaleString(undefined, {
          month: "short", day: "numeric", year: "numeric",
          hour: "numeric", minute: "2-digit"
        });
        el.dataset.localized = "1";
      });
    }
    localizeTimes(document);

    // Infinite scroll: when the loader sentinel enters the viewport,
    // fetch the next page (older than its cursor), append rows, and
    // swap in the new loader. A missing loader in the response means
    // we've hit the tail of the list.
    function setupInfiniteScroll() {
      const list = document.getElementById("ann-list");
      if (!list) return;

      const observer = new IntersectionObserver(async (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const loader = entry.target;
          if (loader.dataset.loading === "1") continue;
          const cursor = loader.dataset.next;
          if (!cursor) { observer.unobserve(loader); loader.remove(); continue; }
          loader.dataset.loading = "1";

          try {
            const resp = await fetch(`/manga/comments?before=${encodeURIComponent(cursor)}`, {
              headers: { Accept: "text/html" },
              credentials: "same-origin",
            });
            if (!resp.ok) { loader.dataset.loading = ""; continue; }
            const html = (await resp.text()).trim();

            const tmpl = document.createElement("template");
            tmpl.innerHTML = html;
            const nodes = Array.from(tmpl.content.children);
            const newRows = nodes.filter(n => n.tagName === "A");
            const newLoader = nodes.find(n => n.id === "ann-loader");

            newRows.forEach(r => list.appendChild(r));
            newRows.forEach(r => localizeTimes(r));
            syncColorButtons(newRows);
            // Re-apply active filters to newly-inserted rows.
            filterAnnotations();

            observer.unobserve(loader);
            if (newLoader) {
              loader.replaceWith(newLoader);
              observer.observe(newLoader);
            } else {
              loader.remove();
            }
          } catch (_) {
            loader.dataset.loading = "";
          }
        }
      }, { rootMargin: "400px 0px" });

      const initial = document.getElementById("ann-loader");
      if (initial) observer.observe(initial);
    }
    setupInfiniteScroll();
  }
</script>
