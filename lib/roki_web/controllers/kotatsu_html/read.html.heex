<%!-- Deliberately minimal vertical reader: a plain image strip through
     the kotatsu proxy. Enough to read end-to-end and judge a source;
     the full Fresco/FrescoStrip integration comes later behind the
     MangaSource behaviour. --%>
<div class="min-h-screen bg-base-300">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between px-4 py-3">
      <a href={~p"/manga/kotatsu/#{@source}/manga?#{%{url: @manga_url}}"} class="btn btn-ghost btn-sm gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="truncate max-w-[40vw]">{(@manga && @manga.title) || "Back"}</span>
      </a>
      <span :if={@chapter} class="text-sm text-base-content/60 truncate">{chapter_label(@chapter)}</span>
    </div>

    <%= if @error do %>
      <div class="alert alert-warning m-4">{@error}</div>
    <% else %>
      <div class="flex flex-col">
        <img
          :for={page <- @pages}
          src={kotatsu_image(@source, page.image_url)}
          loading="lazy"
          class="w-full"
          alt={"Page #{page.index + 1}"}
        />
      </div>

      <div class="flex items-center justify-between gap-3 p-4 pb-12">
        <%= if @prev_chapter do %>
          <a
            href={~p"/manga/kotatsu/#{@source}/read?#{%{url: @manga_url, chapter: @prev_chapter.url}}"}
            class="btn btn-outline flex-1"
          >
            ← {chapter_label(@prev_chapter)}
          </a>
        <% else %>
          <span class="flex-1"></span>
        <% end %>
        <%= if @next_chapter do %>
          <a
            href={~p"/manga/kotatsu/#{@source}/read?#{%{url: @manga_url, chapter: @next_chapter.url}}"}
            class="btn btn-primary flex-1"
          >
            {chapter_label(@next_chapter)} →
          </a>
        <% else %>
          <span class="flex-1 text-center text-sm text-base-content/50">Last chapter</span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
