<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <%!-- viewport-fit=cover: the full-screen player reaches under an iPhone's home indicator and
          keeps its buttons clear of the rounded corners with the safe-area insets (app.css). --%>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- Installed to the home screen or as a desktop app it opens as its own window, without the
          browser's back and reload buttons (manifest.webmanifest: display "standalone"). --%>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ff6a13" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="roki" />
    <%!-- "black", not "default" and not "black-translucent".

          Translucent lets the page paint under the status bar, which is the only way to put a
          gradient up there — and it costs more than it gives: the manga reader pulls its shell
          past the safe-area inset, so with a real inset every snap lands a status bar too high,
          and on every other page the clock sits over the content. Default avoids both and gives
          a bar the colour of the page, which on a reading page is white and bright.
          Black is the third: the page is laid out below the bar, so nothing shifts anywhere,
          and the bar is black rather than white. --%>
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <%!-- The paged reader's panel zoom, read by assets/js/panel_overlay.js. --%>
    <meta
      :if={
        ((assigns[:phoenix_kit_current_user] && assigns[:phoenix_kit_current_user].custom_fields) ||
           %{})["smart_panels"] == true
      }
      name="smart-panels"
      content="1"
    />
    <meta
      name="roki-player-default"
      content={RokiWeb.PlayerMode.default_for(assigns[:phoenix_kit_current_user])}
    />
    <%!-- The tab: the orange play button, and "<what is on the page> · Roki" so it is easy to find
          among many tabs. --%>
    <link rel="icon" type="image/svg+xml" href={~p"/images/icon.svg"} />
    <link rel="icon" type="image/png" sizes="192x192" href={~p"/images/icon-192.png"} />
    <link rel="shortcut icon" href="/favicon.ico" />
    <.live_title default="Roki" suffix=" · Roki" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- Each build's files under a new address (`vsn=` the file's time), so a browser never keeps
          yesterday's script or styles: without it these are cached by guesswork. --%>
    <link
      phx-track-static
      rel="stylesheet"
      href={RokiWeb.Assets.versioned("/assets/css/app.css")}
    />
    <%!-- The typefaces the moods' names are set in (Roki.Mood.fonts/0); a browser only fetches the
          ones a page draws. --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={"https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&" <> Enum.map_join(Roki.Mood.fonts(), "&", &("family=" <> &1)) <> "&display=swap"}
    />
    <!-- PhoenixKit JS Hooks -->
    <script src={~p"/assets/vendor/phoenix_kit.js"}>
    </script>
    <!-- PhoenixKit Module Hooks -->
    <script src={~p"/assets/vendor/phoenix_kit_modules.js"}>
    </script>

    <script
      defer
      phx-track-static
      type="text/javascript"
      src={RokiWeb.Assets.versioned("/assets/js/app.js")}
    >
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", systemTheme());
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        try { const d = (document.querySelector("meta[name=roki-player-default]") || {}).content || "external"; document.documentElement.dataset.player = localStorage.getItem("roki:player") || d } catch (_) { document.documentElement.dataset.player = "external" }
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
    <%!-- phoenix_kit: theme managed by host. The script above owns the
         data-theme attribute; this comment is the documented opt-out that
         stops mix phoenix_kit.install/.update re-offering its own theme
         bootstrap on every run. --%>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
